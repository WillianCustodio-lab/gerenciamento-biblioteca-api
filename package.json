{
  "name": "gerenciamento-biblioteca-api",
  "version": "1.0.0",
  "description": "API para gerenciamento de biblioteca.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillianCustodio-lab/gerenciamento-biblioteca-api.git"
  },
  "keywords": [
    "nodejs",
    "api",
    "postgresql",
    "biblioteca"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WillianCustodio-lab/gerenciamento-biblioteca-api/issues"
  },
  "homepage": "https://github.com/WillianCustodio-lab/gerenciamento-biblioteca-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
